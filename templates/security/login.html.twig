{% extends 'security/_base.html.twig' %}

{% block title %}{{ 'security.login.title'|trans({}, 'security') }} | {{ setting('app_title') ?? 'ERP' }}{% endblock %}

{% block content %}
    {# Welcome Text #}
    <div class="login-welcome">
        <h1>{{ 'security.login.heading'|trans({}, 'security') }}</h1>
        <p>{{ 'security.login.subtitle'|trans({}, 'security') }}</p>
    </div>

    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="login-error" style="background-color: #ecfdf5; color: #059669;">
            <i class="fa-solid fa-check-circle"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    {# Error Message #}
    {% if error %}
        <div class="login-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>
                {{ error.messageKey|trans(error.messageData, 'security') }}

                {% if error.messageData['requires_verification'] is defined %}
                    <br>
                    <a href="{{ path('app_resend_verification', {'email': last_username}) }}" style="color: inherit; text-decoration: underline; font-weight: 600; margin-top: 5px; display: inline-block;">
                        Retrimite emailul de verificare
                    </a>
                {% endif %}
            </span>
        </div>
    {% endif %}

    {# Login Form #}
    <form class="login-form" method="post">
        {# Email Input #}
        <div class="login-input-group">
            <label for="inputEmail">{{ 'security.login.email_label'|trans({}, 'security') }}</label>
            <i class="fa-solid fa-envelope input-icon"></i>
            <input
                type="text"
                id="inputEmail"
                name="_username"
                value="{{ last_username }}"
                placeholder="nume@companie.ro"
                autocomplete="email"
                required
            >
        </div>

        {# Password Input #}
        <div class="login-input-group">
            <label for="inputPassword">{{ 'security.login.password_label'|trans({}, 'security') }}</label>
            <i class="fa-solid fa-lock input-icon"></i>
            <input
                type="password"
                id="inputPassword"
                name="_password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
            >
            <button
                type="button"
                class="password-toggle"
                aria-label="{{ 'security.login.toggle_password'|trans({}, 'security') }}"
            >
                <i class="fa-solid fa-eye" id="toggleIcon"></i>
            </button>
        </div>

        {# CSRF Token #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        {# Remember me & Forgot password #}
        <div class="login-options">
            <div class="login-remember">
                <input type="checkbox" id="remember_me" name="_remember_me">
                <label for="remember_me">{{ 'security.login.remember_me'|trans({}, 'security') }}</label>
            </div>
            <a href="{{ path('app_forgot_password') }}" class="login-forgot">
                {{ 'security.login.forgot_password'|trans({}, 'security') }}
            </a>
        </div>

        {# Submit Button #}
        <button type="submit" class="login-btn">
            <i class="fa-solid fa-right-to-bracket"></i>
            <span>{{ 'security.login.submit'|trans({}, 'security') }}</span>
        </button>
    </form>

    <div class="login-separator"><span>{{ 'security.login.or'|trans({}, 'security') }}</span></div>

    <a href="{{ path('app_login_face') }}" class="login-btn login-btn-secondary">
        <i class="fa-solid fa-camera"></i>
        <span>{{ 'security.login.with_face'|trans({}, 'security') }}</span>
    </a>
{% endblock %}
