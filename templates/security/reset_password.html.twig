{% extends 'security/_base.html.twig' %}

{% block title %}{{ 'security.reset.title'|trans({}, 'security') }} | {{ setting('app_title') ?? 'ERP' }}{% endblock %}

{% block content %}
    <div class="login-welcome">
        <h1>{{ 'security.reset.heading'|trans({}, 'security') }}</h1>
        <p>{{ 'security.reset.subtitle'|trans({}, 'security') }}</p>
    </div>

    {% for type in ['success', 'error'] %}
        {% for message in app.flashes(type) %}
            <div class="login-error" style="{% if type == 'success' %}background-color: #ecfdf5; color: #059669;{% endif %}">
                <i class="fa-solid {% if type == 'success' %}fa-check-circle{% else %}fa-circle-exclamation{% endif %}"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {% if not resetForm.vars.valid %}
        <div class="login-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>
                {{ form_errors(resetForm.plainPassword.first) }}
                {{ form_errors(resetForm.plainPassword.second) }}
                {{ form_errors(resetForm) }}
            </span>
        </div>
    {% endif %}

    {{ form_start(resetForm, {'attr': {'class': 'login-form', 'novalidate': 'novalidate'}}) }}

    <div class="login-input-group">
        <label for="{{ resetForm.plainPassword.first.vars.id }}">
            {{ 'security.change_password.new_password_label'|trans({}, 'security') }}
        </label>
        <i class="fa-solid fa-lock input-icon"></i>
        {{ form_widget(resetForm.plainPassword.first, {
            'attr': {
                'placeholder': 'security.change_password.placeholder'|trans({}, 'security')
            }
        }) }}
        <button type="button" class="password-toggle">
            <i class="fa-solid fa-eye"></i>
        </button>
    </div>

    <div class="login-input-group">
        <label for="{{ resetForm.plainPassword.second.vars.id }}">
            {{ 'security.change_password.confirm_password_label'|trans({}, 'security') }}
        </label>
        <i class="fa-solid fa-lock input-icon"></i>
        {{ form_widget(resetForm.plainPassword.second, {
            'attr': {
                'placeholder': 'security.change_password.placeholder'|trans({}, 'security')
            }
        }) }}
        <button type="button" class="password-toggle">
            <i class="fa-solid fa-eye"></i>
        </button>
    </div>

    <div class="login-options" style="justify-content: center; margin-bottom: 20px;">
        <a href="{{ path('app_login') }}" class="login-forgot">
            <i class="fa-solid fa-arrow-left" style="margin-right: 5px;"></i> {{ 'security.reset.back_to_login'|trans({}, 'security') }}
        </a>
    </div>

    <button type="submit" class="login-btn">
        <i class="fa-solid fa-key"></i>
        <span>{{ 'security.reset.submit'|trans({}, 'security') }}</span>
    </button>

    {{ form_end(resetForm) }}
{% endblock %}
