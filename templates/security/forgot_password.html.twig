{% extends 'security/_base.html.twig' %}

{% block title %}{{ 'security.forgot_password.title'|trans({}, 'security') }} | {{ setting('app_title') ?? 'ERP' }}{% endblock %}

{% block content %}
    <div class="login-welcome">
        <h1>{{ 'security.forgot_password.heading'|trans({}, 'security') }}</h1>
        <p>{{ 'security.forgot_password.subtitle'|trans({}, 'security') }}</p>
    </div>

    {% for type in ['success', 'error'] %}
        {% for message in app.flashes(type) %}
            <div class="login-error" style="{% if type == 'success' %}background-color: #ecfdf5; color: #059669;{% endif %}">
                <i class="fa-solid {% if type == 'success' %}fa-check-circle{% else %}fa-circle-exclamation{% endif %}"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    <form class="login-form" method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

        <div class="login-input-group">
            <label for="inputEmail">{{ 'security.forgot_password.email_label'|trans({}, 'security') }}</label>
            <i class="fa-solid fa-envelope input-icon"></i>
            <input
                type="email"
                id="inputEmail"
                name="email"
                placeholder="nume@companie.ro"
                autocomplete="email"
                required
            >
        </div>

        <div class="login-options" style="justify-content: center; margin: 1rem 0;">
            <a href="{{ path('app_login') }}" class="login-forgot">
                <i class="fa-solid fa-arrow-left"></i> {{ 'security.forgot_password.back_to_login'|trans({}, 'security') }}
            </a>
        </div>

        <button type="submit" class="login-btn">
            <i class="fa-solid fa-paper-plane"></i>
            <span>{{ 'security.forgot_password.submit'|trans({}, 'security') }}</span>
        </button>
    </form>
{% endblock %}
