{% extends 'security/_base.html.twig' %}

{% block title %}{{ 'security.change_password.title'|trans({}, 'security') }} | {{ setting('app_title') ?? 'ERP' }}{% endblock %}

{% block content %}
    <div class="login-welcome">
        <h1>{{ 'security.change_password.title'|trans({}, 'security') }}</h1>
        <p>{{ 'security.change_password.subtitle'|trans({}, 'security') }}</p>
    </div>

    {% if not form.vars.valid %}
        <div class="login-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>
                {{ form_errors(form.plainPassword.first) }}
                {{ form_errors(form.plainPassword.second) }}
                {{ form_errors(form) }}
            </span>
        </div>
    {% endif %}

    {{ form_start(form, {'attr': {'class': 'login-form', novalidate: 'novalidate'}}) }}

    <div class="login-input-group">
        <label for="{{ form.plainPassword.first.vars.id }}">{{ 'security.change_password.new_password_label'|trans({}, 'security') }}</label>
        <i class="fa-solid fa-lock input-icon"></i>
        {{ form_widget(form.plainPassword.first) }}
    </div>

    <div class="login-input-group">
        <label for="{{ form.plainPassword.second.vars.id }}">{{ 'security.change_password.confirm_password_label'|trans({}, 'security') }}</label>
        <i class="fa-solid fa-lock input-icon"></i>
        {{ form_widget(form.plainPassword.second) }}
    </div>

    <button type="submit" class="login-btn" style="margin-top: 1rem;">
        <i class="fa-solid fa-floppy-disk"></i>
        <span>{{ 'security.change_password.submit'|trans({}, 'security') }}</span>
    </button>

    {{ form_end(form) }}
{% endblock %}
