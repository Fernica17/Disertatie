{% set searchTerm = app.request.query.get('search') %}

{% if entity.instance.elements is empty %}
    <div style="text-align: center; padding: 32px 20px; color: var(--mg-text-muted);">
        <i class="fa-solid fa-inbox" style="font-size: 28px; opacity: 0.3; display: block; margin-bottom: 10px;"></i>
        <span>{{ 'elements.template.empty_list'|trans({}, 'lists') }}</span>
    </div>
{% else %}
    <div class="mg-card" style="margin-top: 8px;">
        <div class="mg-card-header" style="padding: 12px 20px;">
            <div class="mg-search" style="max-width: 100%; flex: 1;">
                <i class="fa-solid fa-magnifying-glass"></i>
                <form method="get" style="margin: 0;">
                    <input type="text" name="search" value="{{ searchTerm }}" placeholder="{{ 'elements.template.search_placeholder'|trans({}, 'lists') }}">
                </form>
            </div>
        </div>

        <div class="mg-table-wrapper">
            <table class="mg-table">
                <thead>
                    <tr>
                        <th>{{ 'elements.field.name'|trans({}, 'lists') }}</th>
                        <th style="width: 100px;">{{ 'elements.template.status'|trans({}, 'lists') }}</th>
                        <th>{{ 'elements.field.sub_list'|trans({}, 'lists') }}</th>
                    </tr>
                </thead>
                <tbody>
                {% set has_results = false %}
                {% for element in entity.instance.elements %}
                    {% if searchTerm is empty or element.name matches('/' ~ searchTerm ~ '/i') %}
                        {% set has_results = true %}
                        <tr>
                            <td class="mg-cell-main">{{ element.name }}</td>
                            <td>
                                {% if element.isActive %}
                                    <span class="mg-badge mg-badge-active">
                                        {{ 'elements.status.active'|trans({}, 'lists') }}
                                    </span>
                                {% else %}
                                    <span class="mg-badge mg-badge-inactive">
                                        {{ 'elements.status.inactive'|trans({}, 'lists') }}
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                {% if element.subList %}
                                    {{ element.subList.name }}
                                {% else %}
                                    <span class="null-value">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}

                {% if not has_results %}
                    <tr class="no-results">
                        <td colspan="3" style="text-align: center; padding: 32px 20px; color: var(--mg-text-muted);">
                            <i class="fa-solid fa-search" style="font-size: 24px; opacity: 0.3; display: block; margin-bottom: 10px;"></i>
                            {{ 'elements.template.no_results'|trans({'{search}': searchTerm}, 'lists') }}
                        </td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
