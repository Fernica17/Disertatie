{% extends 'emails/base_email.html.twig' %}

{% trans_default_domain 'notifications' %}

{% block extra_styles %}
    .header {
    background: #aed7d38a !important;
    color: #1f2937 !important;
    padding: 24px 30px;
    border-bottom: 1px solid #e5e7eb;
    }
    .btn-primary {
    display: inline-block;
    background-color: #109B44;
    color: #ffffff !important;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 600;
    margin: 20px 0;
    text-align: center;
    }
    .text-center {
    text-align: center;
    }
{% endblock %}

{% block header_subtitle %}
    {{ 'email.reset_password.subject'|trans }}
{% endblock %}

{% block email_body %}
    <p>{{ 'email.reset_password.greeting'|trans({'{name}': user.firstName ? ' ' ~ user.firstName : ''}) }}</p>

    <p>{{ 'email.reset_password.intro'|trans({'{email}': user.email}) }}</p>

    <p>{{ 'email.reset_password.instruction'|trans }}</p>

    <div class="text-center">
        <a href="{{ url('app_reset_password', {'token': meta.resetToken}) }}" class="btn-primary">
            {{ 'email.reset_password.button'|trans }}
        </a>
    </div>

    <div class="info-box">
        <p style="margin: 0; font-size: 13px; color: #6b7280; line-height: 1.5;">
            {{ 'email.reset_password.warning'|trans }}
        </p>
    </div>
{% endblock %}
