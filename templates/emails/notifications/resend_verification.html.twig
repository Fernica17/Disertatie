{% extends 'emails/base_email.html.twig' %}
{% trans_default_domain 'notifications' %}

{% block extra_styles %}
    .btn { display: inline-block; padding: 12px 24px; background-color: #109B44; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; }
{% endblock %}

{% block header_subtitle %}{{ 'notifications.resend_verification.title'|trans }}{% endblock %}

{% block email_body %}
    <p>{{ 'notifications.resend_verification.greeting'|trans({'{firstName}': user.firstName, '{lastName}': user.lastName}) }}</p>

    <p>{{ 'notifications.resend_verification.instruction'|trans }}</p>

    <p>{{ 'notifications.resend_verification.action_prompt'|trans }}</p>

    <div style="text-align: center; margin: 30px 0;">
        <a href="{{ meta.signedUrl }}" class="btn" style="color: #ffffff;">{{ 'notifications.resend_verification.button'|trans }}</a>
    </div>

    <p style="font-size: 13px; color: #6b7280;">{{ 'notifications.resend_verification.security_info'|trans }}</p>
{% endblock %}

{% block footer %}
    <p>{{ 'notifications.resend_verification.footer_auto_generated'|trans }}</p>
    <p>&copy; {{ 'now'|date('Y') }} {{ setting('app_title') ?? 'ERP' }}</p>
{% endblock %}
